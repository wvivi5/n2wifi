def wireless_iface():
    """N2WIFI_IFACE, else the first interface under /sys/class/net/*/wireless,
    else wlan0."""
    forced = (os.environ.get("N2WIFI_IFACE") or "").strip()
    if forced:
        return forced
    for d in sorted(glob.glob("/sys/class/net/*/wireless")):
        name = d.split("/")[4]
        if name.startswith(("docker", "veth", "br-", "lo")):
            continue
        return name
    # NetworkManager knows too, even when the driver does not expose /wireless
    rc, out, _ = run(["nmcli", "-t", "-f", "DEVICE,TYPE", "device", "status"], timeout=8)
    if rc == 0:
        for line in out.splitlines():
            parts = line.split(":")
            if len(parts) >= 2 and parts[1] == "wifi":
                return parts[0]
    return "wlan0"


IFACE = wireless_iface()


