def die(msg, code=1):
    print("error: " + msg, file=sys.stderr)
    sys.exit(code)


def pop_flag(a, name):
    """Remove a bare flag from argv; True if it was there."""
    if name in a:
        a.remove(name)
        return True
    return False


def pop_opt(a, name):
    """Remove `--name value` from argv and return the value (or None)."""
    if name not in a:
        return None
    i = a.index(name)
    val = a[i + 1] if i + 1 < len(a) else None
    del a[i:i + 2]
    return val


def run(args, timeout=30, check=False):
    """Run a command, return (rc, stdout, stderr) as text. Never raises."""
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        if check and p.returncode != 0:
            return p.returncode, p.stdout, (p.stderr or p.stdout).strip()
        return p.returncode, p.stdout or "", (p.stderr or "").strip()
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"
    except (OSError, FileNotFoundError) as e:
        return 127, "", str(e)


def dw(s):
    """terminal display width (CJK = 2 cells)"""
    w = 0
    for ch in str(s):
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def pad(s, width):
    s = str(s)
    return s + " " * max(0, width - dw(s))


def _freq_num(freq):
    """Accept both `2437` and `2437 MHz` (nmcli prints the unit)."""
    if freq is None:
        return None
    m = re.search(r"\d+", str(freq))
    return int(m.group(0)) if m else None


def chan_of(freq):
    f = _freq_num(freq)
    if f is None:
        return "?"
    if f == 2484:
        return "14"
    if 2412 <= f <= 2472:
        return str((f - 2407) // 5)
    if 5000 < f < 5925:
        return str((f - 5000) // 5)
    return "?"


def band_of(freq):
    f = _freq_num(freq)
    if f is None:
        return "?"
    if 2400 <= f < 2500:
        return "2.4G"
    if 4900 < f < 5925:
        return "5G"
    return str(f) + "M"


def security_of(b):
    if b.get("rsn") and b.get("wpa"):
        return "WPA/WPA2"
    if b.get("rsn"):
        return "WPA2/WPA3"
    if b.get("wpa"):
        return "WPA"
    if b.get("privacy"):
        return "WEP"
    return t("sec_open")


def backup_file(path):
    """Copy `path` to path.n2bak-<ts>, keeping the newest 20."""
    ts = time.strftime("%Y%m%d-%H%M%S")
    dst = path + ".n2bak-" + ts
    n = 2
    while os.path.exists(dst):
        dst = path + ".n2bak-" + ts + "-%d" % n
        n += 1
    shutil.copy2(path, dst)
    try:
        os.chmod(dst, 0o600)
    except OSError:
        pass
    # prune: keep the newest 20 so a chatty script cannot fill the disk
    old = sorted(glob.glob(path + ".n2bak-*"))[:-20]
    for f in old:
        try:
            os.unlink(f)
        except OSError:
            pass
    return dst


