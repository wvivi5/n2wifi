def cmd_add(ssid, psk=None, open_net=False, remind=True):
    if not ssid:
        die(t("ssid_empty"))
    if not open_net:
        if not psk:
            die(t("need_psk"))
        if not (8 <= len(psk) <= 63):
            die(t("psk_len"))

    b = backend_name()
    if not b:
        die(t("be_none"))

    old = saved_networks()
    if ssid in old:
        die(t("already", ssid=ssid))

    bak = None
    if b == "android":
        text = read_text()
        bak = android_backup()
        new_text = insert_block(text, make_block(text, ssid, psk, open_net))
        write_atomic(new_text)
    elif b == "nm":
        nm_add(ssid, psk, open_net)
    else:  # wpa
        bak = wpa_add(ssid, psk, open_net)

    after = saved_networks()
    if ssid not in after or len(after) != len(old) + 1:
        if bak:
            die(t("write_verify_fail", b=bak))
        die("write failed: the network did not appear afterwards")
    print(t("added", ssid=ssid, old=len(old), new=len(after)))
    if bak:
        print(t("backup_line", b=bak))
    if remind:
        print(t("add_only_note"))


def cmd_del(ssid):
    b = backend_name()
    if not b:
        die(t("be_none"))
    old = saved_networks()
    if ssid not in old:
        die(t("no_such_ssid", ssid=ssid))

    bak = None
    if b == "android":
        text = read_text()
        bak = android_backup()
        new_text = text
        for s, blk in parse_networks(text):
            if s == ssid:
                new_text = new_text.replace(blk, "")
                break
        write_atomic(new_text)
    elif b == "nm":
        bak = nm_del(ssid)
    else:
        bak = wpa_del(ssid)

    after = saved_networks()
    if ssid in after or len(after) != len(old) - 1:
        if bak:
            die(t("del_verify_fail", b=bak))
        die("delete failed: the network is still there")
    print(t("deleted", ssid=ssid, n=len(after)))
    if bak:
        print(t("backup_line", b=bak))
    print(t("apply_note"))


def cmd_apply(ssid=None):
    b = backend_name()
    if not b:
        die(t("be_none"))

    if b == "nm":
        nm_apply(ssid)
        return

    if b == "wpa":
        wpa_apply()
        cmd_status()
        return

    # --- android: restart system_server so the framework re-reads the XML ---
    pid = find_pid("system_server")
    if not pid:
        die(t("apply_no_ss"))
    print(t("apply_android", pid=pid))
    print(t("apply_android_hint1"))
    print(t("apply_android_hint2"))
    try:
        os.kill(pid, 9)
    except OSError as e:
        die(t("apply_kill_fail", e=e))
    t0 = time.time()
    newpid = None
    while time.time() - t0 < 180:
        time.sleep(2)
        p = find_pid("system_server")
        if p and p != pid:
            newpid = p
            break
    if newpid:
        print(t("apply_back", pid=newpid, sec=int(time.time() - t0)))
    else:
        print(t("apply_late"))
    t1 = time.time()
    while time.time() - t1 < 90:
        time.sleep(3)
        if current_connection().get("ssid"):
            break
    time.sleep(2)
    cmd_status()


def backup_globs():
    """Where to look for backups, for the active backend."""
    b = backend_name()
    if b == "android":
        return [xml_path() + ".n2bak-*"]
    if b == "wpa":
        return [wpa_conf() + ".n2bak-*"]
    # nm: NetworkManager keyfile profiles
    pats = []
    for d in ("/etc/NetworkManager/system-connections",
              "/etc/NetworkManager/system-connections-merged"):
        pats.append(os.path.join(d, "*.n2bak-*"))
    return pats


def cmd_backups():
    found = []
    for g in backup_globs():
        found.extend(glob.glob(g))
    found.sort()
    if not found:
        print(t("no_backups"))
        return
    for f in found:
        print("%s  (%s)" % (f, time.strftime("%Y-%m-%d %H:%M:%S",
                                             time.localtime(os.path.getmtime(f)))))


def cmd_revert(path=None):
    cands = []
    for g in backup_globs():
        cands.extend(glob.glob(g))
    cands.sort()
    if not path:
        if not cands:
            die(t("no_backups"))
        path = cands[-1]
    if not os.path.exists(path):
        die(t("no_such_backup", p=path))

    b = backend_name()
    if b == "android":
        with open(path, "r", encoding="utf-8") as f:
            chk = f.read()
        if "<NetworkList>" not in chk:
            die(t("bad_backup"))
        shutil.copy2(path, xml_path())
        try:
            os.chmod(xml_path(), 0o600)
            os.chown(xml_path(), UID, GID)
        except OSError:
            pass
    else:
        # wpa / nm: the backup is a copy of a real config file; strip the suffix
        target = path.split(".n2bak-")[0]
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            chk = f.read()
        if not chk.strip():
            die(t("bad_backup"))
        shutil.copy2(path, target)
        if b == "nm":
            # a restored keyfile is ignored until NetworkManager re-reads it
            run(["nmcli", "connection", "reload"], timeout=30)

    print(t("reverted", p=path))
    print(t("apply_note"))


# --------------------------------------------------------------------------
# join guard: roll back automatically when a switch leaves the box offline
#
# On a headless box Wi-Fi is the only uplink, so a bad `join` is not "wrong
# network", it is "gone": no ssh, no way in, until someone power-cycles it.
# The guard is a detached process (own session, so sshd hanging up cannot
# kill it) that starts before the switch is applied, watches the link, and
# restores the pre-join config if the box ends up with no uplink at all.
# --------------------------------------------------------------------------

DEFAULT_GUARD_TIMEOUT = {"android": 120, "nm": 60, "wpa": 45}
DEFAULT_VERIFY = {"android": 150, "nm": 60, "wpa": 45}


def state_dir():
    for d in (os.environ.get("N2WIFI_STATE_DIR"), "/run", "/var/run",
              "/data/local/tmp", "/tmp"):
        if d and os.path.isdir(d) and os.access(d, os.W_OK):
            return d
    return "/tmp"


def guard_state_path():
    return os.path.join(state_dir(), "n2wifi-guard.json")


def guard_log_path():
    return os.path.join(state_dir(), "n2wifi-guard.log")


def gwrite(path, obj):
    """Write JSON atomically -- a reader never sees half a file."""
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def gread(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def link_up():
    """Carrier state, for when the SSID cannot be read (no iw, no nmcli)."""
    try:
        with open("/sys/class/net/%s/operstate" % IFACE) as f:
            return f.read().strip() in ("up", "unknown")
    except OSError:
        return False


def default_gateway():
    """The IPv4 default gateway, or None.

    """
    rc, out, _ = run(["ip", "-4", "route", "show", "default"], timeout=10)
    if rc == 0:
        m = re.search(r"default\s+via\s+(\d+\.\d+\.\d+\.\d+)", out)
        if m and not m.group(1).startswith("0."):
            return m.group(1)
    # no default route yet: fall back to the first on-link address
    rc, out, _ = run(["ip", "-4", "route"], timeout=10)
    if rc == 0:
        m = re.search(r"(\d+\.\d+\.\d+\.\d+)\s+dev\s+" + re.escape(IFACE), out)
        if m:
            return m.group(1)
    return None


def ping_ok():
    """Does the default gateway answer?  Catches 'associated but dead'."""
    gw = default_gateway()
    if not gw:
        return False
    rc, _, _ = run(["ping", "-c", "2", "-W", "2", gw], timeout=10)
    return rc == 0


def bounce_radio(b):
    """Power-cycle the radio and let the backend re-pick a saved network.

    Much cheaper than restoring a snapshot, and it needs no knowledge of
    which network we came from -- the backend's own autoconnect ordering
    does the work.  -> a human-readable description of what was done, or
    None when the backend offers no way to do it.
    """
    if b == "nm":
        run(["nmcli", "radio", "wifi", "off"], timeout=25)
        time.sleep(2)
        rc, _, _ = run(["nmcli", "radio", "wifi", "on"], timeout=25)
        return "nmcli radio wifi off/on" if rc == 0 else None
    if b == "android":
        run(["svc", "wifi", "disable"], timeout=25)
        time.sleep(2)
        rc, _, _ = run(["svc", "wifi", "enable"], timeout=25)
        return "svc wifi disable/enable" if rc == 0 else None
    # wpa: restarting the supplicant makes it walk the config from the top,
    # and the block we just added is not the first one.
    for svc in ("wpa_supplicant@" + IFACE, "wpa_supplicant", "networking"):
        rc, _, _ = run(["systemctl", "restart", svc], timeout=90)
        if rc == 0:
            time.sleep(3)
            return "systemctl restart " + svc
    return None


def link_state(check="ip"):
    """{ssid, ip, ok, blind} -- `ok` means 'this box still has an uplink'."""
    info = current_connection()
    ssid = info.get("ssid") or None
    ip = info.get("ip") or None
    if check == "link":
        ok = bool(ssid) or link_up()
    elif check == "ping":
        ok = bool(ip) and ping_ok()
    else:  # ip
        ok = bool(ip)
    return {"ssid": ssid, "ip": ip, "ok": ok, "blind": ssid is None}


def active_config_file():
    b = backend_name()
    if b == "android":
        return xml_path()
    if b == "wpa":
        return wpa_conf()
    return None  # nm: one keyfile per network, nothing to snapshot


def snapshot_config(tag="prejoin"):
    """Freeze the live config before a switch, so we can put it back."""
    p = active_config_file()
    if not p or not os.path.exists(p):
        return None
    dst = "%s.n2snap-%s" % (p, tag)
    shutil.copy2(p, dst)
    try:
        os.chmod(dst, 0o600)
    except OSError:
        pass
    return dst


def restore_snapshot(snap):
    """Put the snapshot back over the live config (android / wpa only)."""
    if not snap or not os.path.exists(snap):
        return False
    b = backend_name()
    try:
        with open(snap, "r", encoding="utf-8", errors="replace") as f:
            body = f.read()
    except OSError:
        return False
    if b == "android":
        if "<NetworkList>" not in body:
            return False
        shutil.copy2(snap, xml_path())
        try:
            os.chmod(xml_path(), 0o600)
            os.chown(xml_path(), UID, GID)
        except OSError:
            pass
        return True
    if not body.strip():
        return False
    target = snap.split(".n2snap-")[0]
    shutil.copy2(snap, target)
    try:
        os.chmod(target, 0o600)
    except OSError:
        pass
    return True


def reload_quiet(b):
    """Re-apply the restored config without the chatter of cmd_apply."""
    if b == "android":
        pid = find_pid("system_server")
        if not pid:
            return False
        try:
            os.kill(pid, 9)
        except OSError:
            return False
        t0 = time.time()
        while time.time() - t0 < 180:
            time.sleep(2)
            p = find_pid("system_server")
            if p and p != pid:
                time.sleep(3)
                return True
        return False
    if b == "wpa":
        if wpa_live():
            rc, _, _ = wpa_cli(["reconfigure"])
            if rc == 0:
                time.sleep(3)
                return True
        for svc in ("wpa_supplicant@" + IFACE, "wpa_supplicant", "networking"):
            rc, _, _ = run(["systemctl", "restart", svc], timeout=90)
            if rc == 0:
                time.sleep(3)
                return True
        return False
    run(["nmcli", "connection", "reload"], timeout=30)
    return True


def do_rollback(cfg):
    """Get back onto the network we were on before the switch. -> (ok, detail)"""
    b = cfg.get("backend")
    if b in ("android", "wpa"):
        if not restore_snapshot(cfg.get("snap")):
            return False, "no usable pre-join snapshot"
        if not reload_quiet(b):
            return False, "config restored but the reload did not complete"
        return True, "config restored from the pre-join snapshot"
    # nm: drop the profile we just added, then bring the old one back up
    if cfg.get("target"):
        run(["nmcli", "connection", "delete", cfg["target"]], timeout=40)
    run(["nmcli", "connection", "reload"], timeout=30)
    old = cfg.get("old")
    if not old:
        return False, "no previous profile to activate"
    rc, out, err = run(["nmcli", "connection", "up", old], timeout=120)
    if rc != 0:
        return False, (err or out).strip() or ("nmcli exit %d" % rc)
    return True, "re-activated %s" % old


def guard_run(cfg):
    """The detached watchdog.  Returns 0 online / 1 gave up."""
    st = cfg["state"]
    log = cfg["log"]
    target = cfg.get("target")
    old = cfg.get("old")
    check = cfg.get("check", "ip")
    strict = bool(cfg.get("strict"))
    timeout = int(cfg.get("timeout") or 60)
    marker = cfg.get("marker")
    bounce = cfg.get("bounce", True)

    def describe_fail(s):
        if strict and s["ok"]:
            return ("still on %s after %ds, not the target (--strict)"
                    % (s["ssid"] or s["ip"] or "?", timeout))
        return ("no uplink after %ds (ssid=%s ip=%s)"
                % (timeout, s["ssid"] or "-", s["ip"] or "-"))

    def note(phase, msg, **kw):
        rec = {"ts": int(time.time()), "phase": phase, "msg": msg,
               "target": target, "old": old, "backend": cfg.get("backend"),
               "check": check, "strict": strict, "pid": os.getpid()}
        rec.update(kw)
        try:
            gwrite(st, rec)
        except OSError:
            pass
        try:
            with open(log, "a", encoding="utf-8") as f:
                f.write("[%s] %-10s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"),
                                             phase, msg))
        except OSError:
            pass

    note("armed", "armed: target=%s old=%s check=%s timeout=%ds"
                  % (target, old or "-", check, timeout))

    # Wait for the parent to say "apply finished" so the timeout is measured
    # from the switch, not from process start.  If the parent was killed
    # (the ssh session died mid-switch) start counting after a grace period.
    grace = int(cfg.get("grace") or 200)
    t0 = time.time()
    while marker and not os.path.exists(marker):
        if time.time() - t0 > grace:
            note("armed", "parent never signalled the applied switch; "
                          "carrying on anyway")
            break
        time.sleep(1)

    deadline = time.time() + timeout
    s = link_state(check)
    while True:
        if s["ssid"] == target and s["ok"]:
            note("ok", "connected to %s (%s)" % (target, s["ip"] or "-"))
            return 0
        if time.time() >= deadline:
            break
        time.sleep(3)
        s = link_state(check)

    # Still online, just not on the target: that is a successful outcome for
    # a headless box.  Only --strict treats it as a failure worth undoing.
    if not strict and s["ok"]:
        # ...but `apply` flipped autoconnect on for the new profile; put it
        # back so a later boot cannot fight with the network that works.
        if cfg.get("backend") == "nm" and target and s["ssid"] != target:
            run(["nmcli", "connection", "modify", target,
                 "connection.autoconnect", "no"], timeout=30)
        note("ok", "still online via %s -- not the target, left alone"
                   % (s["ssid"] or "ip " + (s["ip"] or "?")), ssid=s["ssid"])
        return 0

    # ---- level 1: power-cycle the radio, let the backend re-pick ----------
    # Cheap (a few seconds), needs no snapshot, and fixes the most common
    # failure by far: the backend is stuck retrying the profile that does
    # not exist.  --strict skips it, because "reachable" is not the point
    # there -- landing on the target is.
    if bounce and not strict:
        note("bounce", "%s; power-cycling the radio to let the backend "
                       "re-pick a saved network" % describe_fail(s))
        if cfg.get("backend") == "nm" and target:
            # must go first: otherwise the radio comes back up and walks
            # straight into the same dead profile again
            run(["nmcli", "connection", "modify", target,
                 "connection.autoconnect", "no"], timeout=30)
        detail = bounce_radio(cfg.get("backend"))
        if detail:
            wait = int(cfg.get("bounce_wait") or 30)
            t1 = time.time()
            while time.time() - t1 < wait:
                s = link_state(check)
                if s["ok"]:
                    note("recovered",
                         "radio power-cycle (%s) brought the link back on %s "
                         "(%s)" % (detail, s["ssid"] or "-",
                                   s["ip"] or "-"),
                         ssid=s["ssid"], ip=s["ip"])
                    return 0
                time.sleep(3)
            note("bounce", "radio power-cycle (%s) did not bring an uplink "
                           "back within %ds" % (detail, wait))
        else:
            note("bounce", "this backend offers no radio power-cycle; "
                           "going straight to rollback")

    # ---- level 2: put the pre-join state back ----------------------------
    if not old:
        note("failed", "switch failed and there is no previous connection to "
                       "fall back to (first setup?) -- nothing was rolled back")
        return 1

    note("rollback", "%s; rolling back to %s" % (describe_fail(s), old))
    okr, detail = do_rollback(cfg)
    if not okr:
        note("failed", "rollback failed: %s" % detail)
        return 1

    verify = int(cfg.get("verify") or 90)
    t1 = time.time()
    while time.time() - t1 < verify:
        s = link_state("link")
        if s["ssid"] == old:
            ip = link_state(check)["ip"]
            note("rolledback", "%s; back on %s (%s)" % (detail, old, ip or "-"),
                 ssid=old, ip=ip)
            return 0
        time.sleep(3)
    note("failed", "%s, but %s did not come back within %ds"
                   % (detail, old, verify))
    return 1


FINAL_PHASES = ("ok", "recovered", "rolledback", "failed")


def follow_guard(proc, timeout, verify):
    """Print the guard's progress while it is still running."""
    st = guard_state_path()
    seen = None
    end = time.time() + timeout + verify + 150
    while time.time() < end:
        rec = gread(st)
        if rec:
            ph = rec.get("phase")
            if ph != seen:
                seen = ph
                if ph not in FINAL_PHASES:
                    print(t("guard_phase", phase=ph, msg=rec.get("msg", "")))
        if rec and rec.get("phase") in FINAL_PHASES:
            break
        if proc is not None and proc.poll() is not None:
            rec = rec or gread(st)
            if rec and rec.get("phase") in FINAL_PHASES:
                break
            if rec is None:
                break
        time.sleep(2)

    rec = gread(st) or {}
    ph = rec.get("phase")
    msg = rec.get("msg", "")
    if ph == "ok":
        print(t("guard_ok", msg=msg))
    elif ph == "recovered":
        print(t("guard_recovered", msg=msg))
    elif ph == "rolledback":
        print(t("guard_rolledback", msg=msg))
        print(t("guard_retry"))
    elif ph == "failed":
        print(t("guard_failed", msg=msg))
    else:
        print(t("guard_pending", p=guard_log_path()))
    return ph


def spawn_guard(cfg):
    cfgfile = os.path.join(state_dir(), "n2wifi-guard.cfg")
    gwrite(cfgfile, cfg)
    logp = cfg["log"]
    try:
        logf = open(logp, "a", encoding="utf-8")
    except OSError:
        logf = None
    try:
        return subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "_guard", cfgfile],
            stdin=subprocess.DEVNULL,
            stdout=logf or subprocess.DEVNULL,
            stderr=logf or subprocess.DEVNULL,
            start_new_session=True,   # survives the ssh hangup
            close_fds=True)
    except OSError:
        return None
    finally:
        if logf:
            logf.close()


def cmd_guard():
    rec = gread(guard_state_path())
    if not rec:
        print(t("guard_none"))
        return
    print(t("guard_last", ts=time.strftime("%Y-%m-%d %H:%M:%S",
                                           time.localtime(rec.get("ts", 0)))))
    print("  phase  : %s" % rec.get("phase"))
    print("  target : %s" % rec.get("target"))
    print("  old    : %s" % (rec.get("old") or "-"))
    print("  msg    : %s" % rec.get("msg", ""))
    print(t("guard_log_hint", p=guard_log_path()))


def cmd_join(ssid, psk=None, open_net=False, timeout=None, check="ip",
             strict=False, guard=True, bounce=True, bounce_wait=None):
    b = backend_name()
    if not b:
        die(t("be_none"))

    before = link_state("link")
    old_ssid = before.get("ssid")

    timeout = int(timeout or DEFAULT_GUARD_TIMEOUT.get(b, 60))
    verify = DEFAULT_VERIFY.get(b, 60)

    # snapshot before the write, so "roll back" means "exactly as it was"
    snap = snapshot_config("prejoin") if b in ("android", "wpa") else None

    cmd_add(ssid, psk, open_net, remind=False)

    if not guard:
        print(t("guard_off"))
        cmd_apply(ssid)
        return

    marker = guard_state_path() + ".applied"
    try:
        os.unlink(marker)
    except OSError:
        pass
    cfg = {"backend": b, "target": ssid, "old": old_ssid, "snap": snap,
           "timeout": timeout, "check": check, "strict": bool(strict),
           "bounce": bool(bounce),
           "bounce_wait": int(bounce_wait or 30),
           "marker": marker, "state": guard_state_path(),
           "log": guard_log_path(), "verify": verify,
           "grace": 240 if b == "android" else 60}
    proc = spawn_guard(cfg)
    if proc is None:
        print(t("guard_spawn_fail"))
        cmd_apply(ssid)
        return

    print(t("guard_armed", pid=proc.pid, old=old_ssid or t("not_connected")))
    print(t("guard_armed2", to=timeout, check=check))
    if not bounce:
        print(t("guard_nobounce"))

    cmd_apply(ssid)          # <-- on a Wi-Fi uplink this may drop our ssh

    try:
        with open(marker, "w", encoding="utf-8") as f:
            f.write(str(int(time.time())))
    except OSError:
        pass

    ph = follow_guard(proc, timeout, verify)
    if ph in ("ok", "rolledback"):
        print("")
        cmd_status()
    elif ph is None or ph == "armed":
        pass


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------

def main():
    global LANG
    a = sys.argv[1:]

    # --lang can appear anywhere
    if "--lang" in a:
        i = a.index("--lang")
        val = a[i + 1] if i + 1 < len(a) else ""
        if val not in ("en", "zh"):
            die("--lang expects 'en' or 'zh'")
        LANG = val
        del a[i:i + 2]

    if not a or a[0] in ("-h", "--help", "help"):
        print(usage())
        return
    if a[0] in ("-V", "--version", "version"):
        print("n2wifi " + VERSION)
        return
    if a[0] in ("backend", "backends"):
        show_backend()
        return

    # internal: the detached watchdog re-invokes us as `_guard <cfgfile>`
    if a[0] == "_guard":
        cfg = gread(a[1]) if len(a) > 1 else None
        if not cfg:
            die("guard: no usable config")
        sys.exit(guard_run(cfg))

    if os.geteuid() != 0:
        die(t("not_root"))

    cmd = a[0]
    if cmd == "list":
        cmd_list()
    elif cmd == "status":
        cmd_status()
    elif cmd == "ip":
        cmd_ip()
    elif cmd == "scan":
        cmd_scan("--all" in a)
    elif cmd in ("add", "join"):
        timeout = pop_opt(a, "--timeout")
        if timeout is not None:
            try:
                timeout = int(timeout)
            except ValueError:
                die(t("bad_timeout"))
            if timeout <= 0:
                die(t("bad_timeout"))
        check = pop_opt(a, "--check") or "ip"
        if check not in ("link", "ip", "ping"):
            die(t("bad_check"))
        bw = pop_opt(a, "--bounce-wait")
        if bw is not None:
            try:
                bw = int(bw)
            except ValueError:
                die(t("bad_bounce_wait"))
            if bw <= 0:
                die(t("bad_bounce_wait"))
        strict = pop_flag(a, "--strict")
        no_guard = pop_flag(a, "--no-guard")
        no_bounce = pop_flag(a, "--no-bounce")
        open_net = pop_flag(a, "--open")
        rest = a[1:]
        if not rest:
            die(t("usage_add") if cmd == "add" else t("usage_join"))
        psk = None if open_net else (rest[1] if len(rest) > 1 else None)
        if cmd == "add":
            cmd_add(rest[0], psk, open_net)
        else:
            cmd_join(rest[0], psk, open_net, timeout=timeout, check=check,
                     strict=strict, guard=not no_guard,
                     bounce=not no_bounce, bounce_wait=bw)
    elif cmd == "del":
        if len(a) < 2:
            die(t("usage_del"))
        cmd_del(a[1])
    elif cmd == "apply":
        cmd_apply()
    elif cmd == "guard":
        cmd_guard()
    elif cmd == "backups":
        cmd_backups()
    elif cmd == "revert":
        cmd_revert(a[1] if len(a) > 1 else None)
    else:
        die(t("unknown_cmd", cmd=cmd, usage=usage()))


if __name__ == "__main__":
    main()
