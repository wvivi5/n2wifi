# BACKEND: wpa_supplicant (wpa_supplicant.conf + wpa_cli)
# ==========================================================================

WPA_CONFS = [
    "/etc/wpa_supplicant/wpa_supplicant-{iface}.conf",
    "/etc/wpa_supplicant/wpa_supplicant.conf",
    "/etc/wpa_supplicant.conf",
]

_WPA_CONF = None


def wpa_conf():
    global _WPA_CONF
    if _WPA_CONF is None:
        override = os.environ.get("N2WIFI_CONF")
        if override:
            _WPA_CONF = override
        else:
            for pat in WPA_CONFS:
                p = pat.format(iface=IFACE)
                if os.path.exists(p):
                    _WPA_CONF = p
                    break
            if not _WPA_CONF:
                _WPA_CONF = WPA_CONFS[0].format(iface=IFACE)
    return _WPA_CONF


def wpa_cli(args, timeout=20):
    base = ["wpa_cli", "-i", IFACE]
    if os.geteuid() == 0:
        base = ["wpa_cli", "-i", IFACE, "-p", "/run/wpa_supplicant"]
    return run(base + args, timeout=timeout)


def wpa_live():
    rc, out, _ = wpa_cli(["ping"])
    return rc == 0 and "PONG" in out


def parse_wpa_conf(text):
    """[(ssid, block_text)] — a block is `network={ ... }` with its comments."""
    out = []
    for m in re.finditer(r"network\s*=\s*\{(.*?)\}", text, re.S):
        body = m.group(1)
        inner = re.search(r'ssid\s*=\s*(?:"([^"]*)"|([0-9a-fA-F]+))', body)
        if not inner:
            continue
        if inner.group(1) is not None:
            ssid = inner.group(1)
        else:
            try:
                ssid = bytes.fromhex(inner.group(2)).decode("utf-8", "replace")
            except Exception:
                ssid = inner.group(2)
        out.append((ssid, m.group(0)))
    return out


def wpa_list():
    """Live list from wpa_cli when possible, otherwise parse the config file."""
    if wpa_live():
        rc, out, _ = wpa_cli(["list_networks"])
        if rc == 0:
            res = []
            for line in out.splitlines()[1:]:
                parts = line.split("\t")
                if len(parts) >= 2 and parts[1]:
                    res.append(parts[1])
            if res or "network id" in out.lower():
                return res
    p = wpa_conf()
    if not os.path.exists(p):
        die(t("wpa_no_conf", paths="\n             ".join(
            x.format(iface=IFACE) for x in WPA_CONFS)))
    with open(p, "r", encoding="utf-8", errors="replace") as f:
        return [s for s, _ in parse_wpa_conf(f.read())]


def wpa_quote_password(psk):
    """wpa_supplicant accepts a plaintext passphrase inside double quotes."""
    return psk


def wpa_add(ssid, psk=None, open_net=False):
    if wpa_live():
        rc, out, _ = wpa_cli(["add_network"])
        nid = (out.strip().splitlines() or [""])[-1].strip()
        if rc != 0 or not nid.isdigit():
            die(t("wpa_add_fail", err=(out or "exit %d" % rc)))
        wpa_cli(["set_network", nid, "ssid", '"%s"' % ssid])
        if open_net:
            wpa_cli(["set_network", nid, "key_mgmt", "NONE"])
        else:
            wpa_cli(["set_network", nid, "psk", '"%s"' % psk])
        rc, out, _ = wpa_cli(["enable_network", nid])
        rc2, out2, _ = wpa_cli(["save_config"])
        if rc2 == 0 and "OK" in out2:
            return None
        # save_config refused (ctrl_interface not writable) -> fall through to the file
    p = wpa_conf()
    if not os.path.exists(p):
        die(t("wpa_no_conf", paths="\n             ".join(
            x.format(iface=IFACE) for x in WPA_CONFS)))
    with open(p, "r", encoding="utf-8", errors="replace") as f:
        text = f.read()
    if any(s == ssid for s, _ in parse_wpa_conf(text)):
        die(t("already", ssid=ssid))
    b = backup_file(p)
    if open_net:
        blk = ('network={\n\tssid="%s"\n\tkey_mgmt=NONE\n}\n' % ssid)
    else:
        blk = ('network={\n\tssid="%s"\n\tpsk="%s"\n}\n' % (ssid, wpa_quote_password(psk)))
    with open(p, "a", encoding="utf-8") as f:
        f.write("\n" + blk)
    return b


def wpa_del(ssid):
    if wpa_live():
        rc, out, _ = wpa_cli(["list_networks"])
        nid = None
        for line in out.splitlines()[1:]:
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1] == ssid and parts[0].isdigit():
                nid = parts[0]
                break
        if nid is not None:
            wpa_cli(["remove_network", nid])
            wpa_cli(["save_config"])
            return None
    p = wpa_conf()
    if not os.path.exists(p):
        die(t("wpa_no_conf", paths="\n             ".join(
            x.format(iface=IFACE) for x in WPA_CONFS)))
    with open(p, "r", encoding="utf-8", errors="replace") as f:
        text = f.read()
    nets = parse_wpa_conf(text)
    if not any(s == ssid for s, _ in nets):
        die(t("no_such_ssid", ssid=ssid))
    b = backup_file(p)
    for s, blk in nets:
        if s == ssid:
            text = text.replace(blk, "", 1)
            break
    with open(p, "w", encoding="utf-8") as f:
        f.write(text)
    return b


def wpa_apply():
    if wpa_live():
        print(t("apply_wpa"))
        rc, out, _ = wpa_cli(["reconfigure"])
        if rc == 0:
            time.sleep(2)
            return
    print(t("apply_wpa_restart"))
    for svc in ("wpa_supplicant@" + IFACE, "wpa_supplicant", "networking"):
        rc, _, _ = run(["systemctl", "restart", svc], timeout=90)
        if rc == 0:
            time.sleep(3)
            return


# ==========================================================================
# BACKEND selection
# ==========================================================================

_ALIASES = {
    "android": "android",
    "nm": "nm", "networkmanager": "nm", "network-manager": "nm",
    "wpa": "wpa", "wpa_supplicant": "wpa", "wpa-supplicant": "wpa",
    "wpasupplicant": "wpa",
}


def detect_backend():
    """Return 'android' | 'nm' | 'wpa' | None, plus a short reason."""
    forced = (os.environ.get("N2WIFI_BACKEND") or "").strip().lower()
    if forced:
        b = _ALIASES.get(forced)
        if not b:
            die("N2WIFI_BACKEND must be one of: android, nm, wpa")
        return b, "forced by N2WIFI_BACKEND"

    # 1) Android: the config store exists
    for p in CANDIDATES:
        for cand in (p, ANDROID_ROOT + p):
            if os.path.exists(cand):
                return "android", cand

    # 2) NetworkManager: binary present AND the daemon answers
    if shutil.which("nmcli") and nm_running():
        return "nm", "nmcli + running daemon"

    # 3) wpa_supplicant: config file or a reachable control socket
    for pat in WPA_CONFS:
        p = pat.format(iface=IFACE)
        if os.path.exists(p):
            return "wpa", p
    if shutil.which("wpa_cli") and wpa_live():
        return "wpa", "wpa_cli control socket"

    return None, ""


_BE = None


def backend():
    """(name, detail) — resolved once."""
    global _BE
    if _BE is None:
        _BE = detect_backend()
    return _BE


def backend_name():
    return backend()[0] or ""


def saved_networks():
    """Saved SSID list, whichever backend is active."""
    b = backend_name()
    if b == "android":
        return [s for s, _ in parse_networks(read_text())]
    if b == "nm":
        return nm_list()
    if b == "wpa":
        return wpa_list()
    die(t("be_none"))


def show_backend():
    b, detail = backend()
    if not b:
        die(t("be_none"))
    dst = {"android": "desc_android", "nm": "desc_nm", "wpa": "desc_wpa"}[b]
    print(t("be_header", name=b, desc=t(dst)))
    if b == "android":
        print(t("be_store", path=xml_path()))
    elif b == "wpa":
        print(t("be_store", path=wpa_conf()))
    else:
        print(t("be_store", path="/etc/NetworkManager/system-connections/"))
    print(t("be_iface", iface=IFACE))
    if detail:
        print("         (%s)" % detail)


# --------------------------------------------------------------------------
# connection state (all backends)
# --------------------------------------------------------------------------

def current_connection():
    """{ssid, signal, freq, ip} — NetworkManager first, then iw, then ip."""
    info = {}
    b = backend_name()

    if b == "nm":
        rc, out, _ = run(["nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL,FREQ", "device", "wifi"],
                         timeout=10)
        if rc == 0:
            for line in out.splitlines():
                parts = [nm_unescape(x) for x in re.split(r"(?<!\\):", line)]
                if len(parts) >= 4 and parts[0] == "yes":
                    info["ssid"] = ":".join(parts[1:-2])
                    info["signal"] = parts[-2].strip() + "%"
                    fn = _freq_num(parts[-1])
                    if fn:
                        info["freq"] = str(fn) + " MHz"
                    break

    if not info.get("ssid") and shutil.which("iw"):
        rc, out, _ = run(iw_cmd(["dev", IFACE, "link"]), timeout=15)
        if rc == 0:
            m = re.search(r"SSID:\s*(.+)", out)
            if m:
                info["ssid"] = m.group(1).strip()
            m = re.search(r"signal:\s*(.+)", out)
            if m:
                info["signal"] = m.group(1).strip()
            m = re.search(r"freq:\s*(\d+)", out)
            if m:
                info["freq"] = m.group(1) + " MHz"

    rc, out, _ = run(["ip", "-4", "addr", "show", IFACE], timeout=10)
    if rc == 0:
        m = re.search(r"inet (\d+\.\d+\.\d+\.\d+/\d+)", out)
        if m:
            info["ip"] = m.group(1)
    if "freq" not in info:
        rc, out, _ = run(["iw", "dev", IFACE, "info"], timeout=10) if shutil.which("iw") else (1, "", "")
        if rc == 0:
            m = re.search(r"channel (\d+) \((\d+) MHz\)", out)
            if m:
                info["freq"] = m.group(2) + " MHz"
    return info


