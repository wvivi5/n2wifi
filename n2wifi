def nm_running():
    rc, out, _ = run(["nmcli", "-t", "-f", "RUNNING", "general", "status"], timeout=8)
    return rc == 0 and "running" in out.lower()


def nm_unescape(s):
    """nmcli -t escapes ':' and '\\' inside fields."""
    return s.replace("\\:", ":").replace("\\\\", "\\")


def nm_list():
    """saved Wi-Fi *profiles* (connection names, which we keep == SSID).

    Note: `nmcli -t` prints the raw settings name, so a Wi-Fi profile shows up
    as `802-11-wireless`, not `wifi` (that is only the pretty-printed form).
    Both spellings are accepted.
    """
    rc, out, err = run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"], timeout=15)
    if rc != 0:
        die(t("scan_fail", err=err or ("exit %d" % rc)))
    out_list = []
    for line in out.splitlines():
        if not line.strip():
            continue
        if line.count(":") >= 1:
            name, typ = line.rsplit(":", 1)
        else:
            continue
        if typ.strip() in ("wifi", "802-11-wireless"):
            out_list.append(nm_unescape(name.strip()))
    return out_list


def nm_add(ssid, psk=None, open_net=False):
    # a profile whose name equals the SSID keeps `list`/`del` predictable.
    # autoconnect is off so that `add` really means "write only, do not switch"
    # -- `join`/`apply` turn it back on.
    args = ["nmcli", "connection", "add", "type", "wifi",
            "con-name", ssid, "ssid", ssid,
            "connection.autoconnect", "no"]
    if open_net:
        args += ["wifi-sec.key-mgmt", "none"]
    else:
        args += ["wifi-sec.key-mgmt", "wpa-psk", "wifi-sec.psk", psk]
    rc, out, err = run(args, timeout=60)
    if rc != 0:
        die(t("nm_add_fail", err=(err or out).strip() or ("exit %d" % rc)))
    return None  # NetworkManager keeps its own profile files


def nm_del(ssid):
    # snapshot the keyfile first: `nmcli connection delete` has no undo
    bak = None
    p = nm_profile_path(ssid)
    if p:
        bak = backup_file(p)
    rc, out, err = run(["nmcli", "connection", "delete", ssid], timeout=60)
    if rc != 0:
        die(t("nm_del_fail", err=(err or out).strip() or ("exit %d" % rc)))
    return bak


def nm_profile_path(ssid):
    """path of the .nmconnection file, when NetworkManager uses the keyfile plugin"""
    for d in ("/etc/NetworkManager/system-connections",
              "/etc/NetworkManager/system-connections-merged"):
        for pat in ("%s.nmconnection", "%s"):
            p = os.path.join(d, pat % ssid)
            if os.path.exists(p):
                return p
    return None


def nm_apply(ssid=None):
    target = ssid or (nm_list() or [None])[0]
    if not target:
        return
    # `add` stores the profile with autoconnect off; activate means "use it now"
    run(["nmcli", "connection", "modify", target, "connection.autoconnect", "yes"], timeout=30)
    print(t("apply_nm", ssid=target))
    rc, out, err = run(["nmcli", "connection", "up", target], timeout=120)
    if rc != 0:
        # not fatal: the profile is saved, it will come up on the next boot
        print(t("nm_apply_fail", err=(err or out).strip() or ("exit %d" % rc)),
              file=sys.stderr)


