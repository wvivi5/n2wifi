def iw_scan():
    err = ""
    for _ in range(3):
        try:
            p = subprocess.run(iw_cmd(["dev", IFACE, "scan"]),
                               capture_output=True, text=True, timeout=45)
        except subprocess.TimeoutExpired:
            err = t("scan_timeout")
            break
        if p.returncode == 0 and "BSS " in p.stdout:
            return p.stdout
        err = (p.stderr or p.stdout).strip() or ("exit %d" % p.returncode)
        if "busy" not in err.lower():
            break
        time.sleep(2)
    die(t("scan_fail", err=err))


def parse_scan(text):
    out = []
    cur = None
    for line in text.splitlines():
        if line.startswith("BSS "):
            if cur:
                out.append(cur)
            m = re.match(r"BSS ([0-9a-fA-F:]{17})", line)
            cur = {"bssid": m.group(1) if m else "?", "freq": "", "signal": None,
                   "ssid": "", "privacy": False, "rsn": False, "wpa": False,
                   "associated": "associated" in line}
            continue
        if cur is None:
            continue
        s = line.strip()
        if s.startswith("freq:"):
            cur["freq"] = s.split(":", 1)[1].strip()
        elif s.startswith("signal:"):
            m = re.search(r"(-?\d+(?:\.\d+)?)", s)
            if m:
                cur["signal"] = float(m.group(1))
        elif s.startswith("SSID:"):
            cur["ssid"] = s.split(":", 1)[1].strip()
        elif s.startswith("capability:"):
            cur["privacy"] = "Privacy" in s
        elif s.startswith("RSN:"):
            cur["rsn"] = True
        elif s.startswith("WPA:"):
            cur["wpa"] = True
    if cur:
        out.append(cur)
    return out


def nm_scan():
    """Fallback scan through NetworkManager (no iw needed).

    `nmcli -t -f ... device wifi list` is colon-separated with '\\:' escapes.
    Requested fields: BSSID,SSID,SIGNAL,FREQ,SECURITY.  FREQ is in MHz.
    """
    rc, out, err = run(["nmcli", "-t", "-f", "BSSID,SSID,SIGNAL,FREQ,SECURITY",
                        "device", "wifi", "list", "--rescan", "yes"], timeout=60)
    if rc != 0:
        # older nmcli: retry without --rescan
        rc, out, err = run(["nmcli", "-t", "-f", "BSSID,SSID,SIGNAL,FREQ,SECURITY",
                            "device", "wifi", "list"], timeout=60)
    if rc != 0:
        die(t("scan_fail", err=(err or out).strip() or ("exit %d" % rc)))

    aps = []
    cur_ssid = None
    for line in out.splitlines():
        if not line.strip():
            continue
        # split on unescaped colons
        parts = re.split(r"(?<!\\):", line)
        parts = [nm_unescape(x) for x in parts]
        if len(parts) < 5:
            continue
        bssid, ssid, sig, freq, sec = parts[0], parts[1], parts[2], parts[3], parts[4]
        if not bssid:
            # continuation row of the same SSID
            ssid = cur_ssid or ""
        cur_ssid = ssid
        try:
            signal = int(sig)
        except ValueError:
            signal = None
        aps.append({
            "bssid": bssid or "?",
            "ssid": ssid or "",
            "signal": signal,
            "freq": freq,
            "privacy": sec not in ("", "--"),
            "rsn": "WPA2" in sec or "WPA3" in sec,
            "wpa": sec.startswith("WPA1") or sec == "WPA1 WPA2",
            "associated": False,
            "sec": sec,
            "pct": True,          # nmcli reports 0-100, iw reports dBm
        })
    return aps


def cmd_scan(show_all=False):
    raw = None
    if shutil.which("iw"):
        try:
            raw = parse_scan(iw_scan())
            for a in raw:
                a["sec"] = security_of(a)
        except SystemExit:
            raw = None          # iw present but unusable -> fall back to nmcli
    if raw is None:
        if shutil.which("nmcli"):
            raw = nm_scan()
        else:
            die(t("no_iw"))
    aps = raw
    if not aps:
        print(t("scan_none"))
        return
    cur = current_connection().get("ssid")
    try:
        saved = set(saved_networks())
    except SystemExit:
        saved = set()
    if show_all:
        rows = sorted(aps, key=lambda b: (b["signal"] is None, -(b["signal"] or -200)))
    else:
        best = {}
        for b in aps:
            k = b["ssid"] or t("hidden")
            if k not in best or (b["signal"] or -200) > (best[k]["signal"] or -200):
                best[k] = b
        rows = sorted(best.values(), key=lambda b: -(b["signal"] or -200))
    print(t("scan_head", aps=len(aps), ssids=len(rows)))
    hdr = (pad(t("col_signal"), 10) + pad(t("col_band"), 6)
           + pad(t("col_chan"), 6) + pad(t("col_sec"), 12))
    if show_all:
        hdr += pad(t("col_bssid"), 19)
    print("  " + hdr + t("col_ssid"))
    for b in rows:
        name = b["ssid"] or t("hidden")
        if b["signal"] is None:
            sig = "-"
        elif b.get("pct"):
            sig = "%d%%" % b["signal"]
        else:
            sig = "%d dBm" % round(b["signal"])
        sec = b.get("sec") or security_of(b)
        if sec.strip() in ("", "--"):
            sec = t("sec_open")
        tags = []
        if name == cur:
            tags.append(t("tag_current"))
        elif name in saved:
            tags.append(t("tag_saved"))
        if b["associated"]:
            tags.append(t("tag_assoc"))
        tail = ("   [" + ",".join(tags) + "]") if tags else ""
        line = ("  " + pad(sig, 10) + pad(band_of(b["freq"]), 6)
                + pad(chan_of(b["freq"]), 6) + pad(sec, 12))
        if show_all:
            line += pad(b["bssid"], 19)
        print(line + name + tail)
    if not show_all:
        print("")
        print(t("scan_hint"))


